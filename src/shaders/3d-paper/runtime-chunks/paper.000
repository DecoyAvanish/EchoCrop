<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>3D Paper — Fine Print X-Ray Lease</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%230b0b0d'/%3E%3Ccircle cx='13' cy='19' r='6' fill='%23fff'/%3E%3Ccircle cx='25' cy='23' r='2.6' fill='%23fff'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Inter+Tight:wght@400;500;600;700&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
:root{ --bg:#08080a; --ink:#f2f2f0; --dim:rgba(242,242,240,.38); }
*{margin:0;padding:0;box-sizing:border-box}
html,body{height:100%;background:var(--bg);overflow:hidden;
  touch-action:none;overscroll-behavior:none}
body{
  color:var(--ink);
  font-family:"Inter",-apple-system,BlinkMacSystemFont,"Helvetica Neue",sans-serif;
  -webkit-font-smoothing:antialiased;
}
.mono{font-size:10px;letter-spacing:.2em;text-transform:uppercase;font-weight:500;color:var(--dim)}

/* ---------- background: one giant word, nothing else ---------- */
#bg{position:fixed;inset:0;z-index:1;overflow:hidden}
#bg h1{
  position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);
  line-height:.8;white-space:nowrap;
  -webkit-user-select:none;user-select:none;
  font-family:"Inter Tight",sans-serif;font-weight:600;letter-spacing:-.055em;
  font-size:clamp(96px,18.6vw,420px);color:rgba(56,225,255,.075);
}

/* ---------- layers over it ---------- */
#dof{position:fixed;inset:-30px;z-index:2;pointer-events:none;
     backdrop-filter:blur(2.4px);-webkit-backdrop-filter:blur(2.4px);
     background:rgba(8,8,10,.05)}
#gl{position:fixed;top:0;left:0;width:100%;height:100%;z-index:3;
    pointer-events:none;display:block}
#grain,#grain2{position:fixed;inset:0;z-index:4;pointer-events:none;
    background-repeat:repeat;background-size:160px 160px}
#grain{opacity:.05;mix-blend-mode:overlay}
#grain2{opacity:.02}
#vig{position:fixed;inset:0;z-index:5;pointer-events:none;
     background:radial-gradient(120% 90% at 50% 45%,rgba(0,0,0,0) 42%,rgba(0,0,0,.52) 100%)}
#hint{position:fixed;left:0;right:0;bottom:64px;z-index:6;pointer-events:none;
      text-align:center;font-size:10px;letter-spacing:.22em;text-transform:uppercase;
      color:rgba(242,242,240,.30);opacity:0;transition:opacity .8s ease}
#hint b{font-weight:500;color:rgba(242,242,240,.58)}
@media(hover:none){ #hint .ptr{display:none} }

</style>

<div id="bg" aria-hidden="true"></div>

<div id="dof"></div>
<canvas id="gl"></canvas>
<div id="grain"></div>
<div id="grain2"></div>
<div id="vig"></div>
<div id="hint"><b>Drag</b> to turn it<span class="ptr"> &nbsp;·&nbsp; <b>Hover</b> to light it</span></div>

<script>/**
 * @license
 * Copyright 2010-2023 Three.js Authors
 * SPDX-License-Identifier: MIT
 */
